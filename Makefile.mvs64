ifndef BIOS
$(error NeoGeo BIOS not specified: use make mvs64 BIOS=<bios.bin>)
endif
ifndef ROM
$(error NeoGeo game ROM not specified: use make mvs64 ROM=<rom.zip>)
endif

BUILD_DIR = build/mvs64

include $(N64_INST)/include/n64.mk

core_src = emu.c roms.c hw.c video.c platform_n64.c sprite_cache.c sound_neogeo.c z80.c ym2610/ym2610.c lib/rdl.c $(wildcard hle_*.c)
rsp = rsp_video.S rsp_audio.S
ifdef MUSASHI
# Fallback 68k core: portable Musashi (proven on the PC build). Slower than m64k
# but known-good — use while m64k opcode bugs are investigated. No m64k TLB asm;
# memory goes through the banks[] callbacks in hw.c.
src = $(core_src) m68kcpu.c m68kops.c m68kdasm.c
asm =
else
# Default: fast m64k MIPS-asm 68k interpreter (0xFF000000 TLB window + hw_n64.S).
src = $(core_src) m64k/m64k.c m64k/tlb.c
asm = hw_n64.S m64k/m64k_asm.S
CFLAGS += -DUSE_M64K
# DBF block-op fast path (fused copy/fill loops; VRAM-port helper lives in
# hw_n64.S, so only game builds enable it — the standalone testsuite link
# has no hw_n64.S and must not reference its symbols).
CFLAGS += -DM64K_BLOCKOPS
ASFLAGS += -DM64K_BLOCKOPS
N64_ASFLAGS += -DM64K_BLOCKOPS
endif
obj = $(src:%.c=$(BUILD_DIR)/%.o) $(asm:%.S=$(BUILD_DIR)/%.o) $(rsp:%.S=$(BUILD_DIR)/%.o)

src_makerom = mvsmakerom.c miniz.c
obj_makerom = $(src_makerom:%.c=$(BUILD_DIR)/%.o)

CFLAGS += -Wno-unused-function
CFLAGS += $(EXTRA_DEFINES)

# NOTE: -O3 on the audio TUs (ym2610.c/z80.c/sound_neogeo.c) was tried and
# REGRESSED in-match snd% by ~+40% (ares A/B, 2026-07-02): the inline/unroll
# bloat thrashes the VR4300's 16KB icache in the synthesis loop. Keep -O2.
# The opposite experiment (code-size-first, AUDIO_OS=1) was ALSO tried
# (2026-07-07): -Os REGRESSED in-match snd% 136->155 (fps 22->19.3) — the
# shorter-but-branchier codegen loses more in the synthesis inner loops than
# the icache saves. -O2 is the confirmed sweet spot from both directions.
ifdef AUDIO_OS
$(BUILD_DIR)/ym2610/ym2610.o: CFLAGS += -Os
$(BUILD_DIR)/z80.o: CFLAGS += -Os
$(BUILD_DIR)/sound_neogeo.o: CFLAGS += -Os
endif
# Propagate EXTRA_DEFINES to the assembler too, so .S-file feature gates
# (e.g. -DMVS64_IDLEPROBE in m64k_asm.S) take effect like C ones.
ASFLAGS += $(EXTRA_DEFINES)
N64_ASFLAGS += $(EXTRA_DEFINES)

ROMNAME=$(notdir $(basename $(ROM)))
ROMDIR=$(ROM:%.zip=%.n64)

all: mvsmakerom mvs64-${ROMNAME}.z64

test:
	make -f Makefile.tests all

$(BUILD_DIR)/mvs64-${ROMNAME}.dfs: $(ROM) mvsmakerom
	@echo "    [MVS] ${ROMDIR}"
	./mvsmakerom $(BIOS) $(ROM)
	@echo "    [DFS] $@"
	$(N64_MKDFS) $@ $(ROMDIR) >/dev/null

mvs64-${ROMNAME}.z64: $(BUILD_DIR)/mvs64-${ROMNAME}.dfs
mvs64-${ROMNAME}.z64: N64_ROM_TITLE="MVS64: ${ROMNAME}"
$(BUILD_DIR)/mvs64-${ROMNAME}.elf: $(obj)

mvsmakerom: $(obj_makerom)
	@echo "    [LD] $@"
	$(CC) $(LDFLAGS) -o $@ $^

clean:
	rm -f $(obj)
	rm -f $(obj_makerom)
	rm -f $(asm:%.S=$(BUILD_DIR)/%.o)
	rm -f $(rsp:%.S=$(BUILD_DIR)/%.rsp)
	rm -f $(src:%.c=$(BUILD_DIR)/%.d) $(asm:%.S=$(BUILD_DIR)/%.d)
	rm -f mvs64-*.elf
	rm -f mvs64-*.dfs
	rm -f mvs64-*.z64

-include $(src:%.c=$(BUILD_DIR)/%.d) $(asm:%.S=$(BUILD_DIR)/%.d) $(src_makerom:%.c=$(BUILD_DIR)/%.d)

.PHONY: clean test

ifndef BIOS
$(error NeoGeo BIOS not specified: use make mvs64 BIOS=<bios.bin>)
endif
ifndef ROM
$(error NeoGeo game ROM not specified: use make mvs64 ROM=<rom.zip>)
endif

BUILD_DIR = build/mvs64

include $(N64_INST)/include/n64.mk

core_src = emu.c roms.c hw.c video.c platform_n64.c sprite_cache.c sound_neogeo.c z80_anchor.c z80.c ym2610/ym2610.c lib/rdl.c pcprof.c $(wildcard hle_*.c)
rsp = rsp_video.S rsp_audio.S rsp_fm.S
ifdef MUSASHI
# Fallback 68k core: portable Musashi (proven on the PC build). Slower than m64k
# but known-good — use while m64k opcode bugs are investigated. No m64k TLB asm;
# memory goes through the banks[] callbacks in hw.c.
src = $(core_src) m68kcpu.c m68kops.c m68kdasm.c
asm =
else
# Default: fast m64k MIPS-asm 68k interpreter (0xFF000000 TLB window + hw_n64.S).
src = $(core_src) m64k/m64k.c m64k/tlb.c m64k/dynrec.c
asm = hw_n64.S m64k/m64k_asm.S
CFLAGS += -DUSE_M64K
# DBF block-op fast path (fused copy/fill loops; VRAM-port helper lives in
# hw_n64.S, so only game builds enable it — the standalone testsuite link
# has no hw_n64.S and must not reference its symbols).
# Disable with make ... BLOCKOPS_OFF=1: the fused path must be bit- and
# cycle-exact against the unfused interpreter, so ON-vs-OFF is its gate
# (identical [TRCRC] streams).
ifndef BLOCKOPS_OFF
CFLAGS += -DM64K_BLOCKOPS
ASFLAGS += -DM64K_BLOCKOPS
N64_ASFLAGS += -DM64K_BLOCKOPS
endif
# Inline LSPC VRAM-port stores in the hot MOVE.w fast paths (m64k_asm.S
# port_store_check): the 0x3C0000/2/4 writes skip the TLB trap. Game builds
# only (references lspc.c's reg_vram_* and VIDEO_RAM). PORTSTORE_OFF=1
# compiles it out; -DMVS64_PORTSTORE_OFF is the layout-identical twin.
ifndef PORTSTORE_OFF
ASFLAGS += -DM64K_PORTSTORE
N64_ASFLAGS += -DM64K_PORTSTORE
endif
# m64k inline fast paths for the profile-dominant opcode forms (Bcc condition
# dispatch, hot MOVE.b/.w forms, TST.b/.w (d16,An)) — testsuite-covered (the
# standalone m64k testsuite build enables the same define). Disable with
# make ... FP_OFF=1 for A/B measurement.
ifndef FP_OFF
CFLAGS += -DM64K_FASTPATHS
ASFLAGS += -DM64K_FASTPATHS
N64_ASFLAGS += -DM64K_FASTPATHS
endif
# m64k dynarec (60fps campaign, PLAN-OPTIMIZATION.md blueprint): translates
# hot 68000 ROM code into MIPS blocks in a 256KB arena (per-instruction
# templates, branch enders, direct block chaining, write-through An register
# cache), entered through the block-table probes at _m64k_asmrun entry and
# jmp_exec; hw_n64.S traps accept arena EPCs ([DYNTEST] proves it at boot).
# Bit-exact vs the interpreter (TRCRC + the m64k emitter-differential rig)
# but fps-flat at ~10% residency: template coverage is the missing piece.
# Opt-in: make ... DYNREC_ON=1.
ifdef DYNREC_ON
CFLAGS += -DM64K_DYNREC
ASFLAGS += -DM64K_DYNREC
N64_ASFLAGS += -DM64K_DYNREC
endif
# Deterministic per-slice 68k state-trace hash printed per frame ([TRCRC]);
# the dynarec bit-exactness gate. Opt-in: make ... TRCRC_ON=1.
ifdef TRCRC_ON
CFLAGS += -DM64K_TRACECRC
endif
# Dynarec coverage rig ([DYNSTAT]/[DYNH], diagnostic like OPHIST — use the
# counts, not the fps): counts control-transfer targets at jmp_exec with
# the probe's exact visibility, dumps totals + PC-region split + top-16
# heads every 600 frames. Opt-in: make ... DYNSTAT_ON=1.
ifdef DYNSTAT_ON
CFLAGS += -DM64K_DYNSTAT
ASFLAGS += -DM64K_DYNSTAT
N64_ASFLAGS += -DM64K_DYNSTAT
endif
endif
obj = $(src:%.c=$(BUILD_DIR)/%.o) $(asm:%.S=$(BUILD_DIR)/%.o) $(rsp:%.S=$(BUILD_DIR)/%.o)

src_makerom = mvsmakerom.c miniz.c
obj_makerom = $(src_makerom:%.c=$(BUILD_DIR)/%.o)

CFLAGS += -Wno-unused-function
CFLAGS += $(EXTRA_DEFINES)

# RSP ADPCM offload (rsp_audio.S + ym2610.c rspa_* glue): default ON.
# The YM2610 ADPCM-A/B decoders run on the RSP pipelined under the CPU's FM
# pass (gated bit-exact vs the C core; ares 300s dual-compute run, 35840
# chunks, 0 mismatches; in-fight fps 22.0 -> 26.3). Disable with
# make ... ADPCM_CPU=1 to force the C decoders (debug/fallback).
ifndef ADPCM_CPU
CFLAGS += -DMVS64_RSPADPCM
endif
# Whole-pump audio batching (WHOLEPUMP-DESIGN.md): deferred per-chunk FM AND
# ADPCM on the RSP with RSP-resident dynamic state, cross-pump output
# deferral in plat_audio_pump. Default ON since full WP-M2 (2026-07-08):
# same-source 600s ares A/B, content-matched fight buckets, roughly DOUBLES
# in-fight fps (19.2->35.9, 17.2->31.5, 16.5->26.4, 14.3->21.6 across spr
# density buckets; snd 150-310% -> 51-64%). Bit-exactness gate green (300s,
# 40960 chunks, 0 mismatches FM+ADPCM, 0 hatches). Disable with WP_OFF=1;
# add EXTRA_DEFINES=-DMVS64_RSPWP_VERIFY for the dual-compute gate
# ([RSPWP] counters). MVS64_RSPFM is the FM-on-RSP machinery (rsp_fm.S,
# ym2610.c rspfm_*) the whole pump drives; the synchronous per-chunk FM
# offload it was built for measured net-negative and was removed.
ifndef WP_OFF
CFLAGS += -DMVS64_RSPFM -DMVS64_RSPWP
endif

ifdef FRAMESKIP
# Auto frameskip: skip drawing up to $(FRAMESKIP) frames in a row when the
# emulation is behind the VI clock, so game speed holds (emu_render, emu.c).
# Default off (0): the game slows down instead.
CFLAGS += -DMVS64_FRAMESKIP=$(FRAMESKIP)
endif

# NOTE: the audio TUs (ym2610.c/z80.c/sound_neogeo.c) stay at -O2, measured
# from both directions. -O3 REGRESSED in-match snd% by ~+40% (ares A/B,
# 2026-07-02): the inline/unroll bloat thrashes the VR4300's 16KB icache in
# the synthesis loop. -Os on all three REGRESSED snd% 136->155 (fps 22->19.3,
# 2026-07-07): the shorter-but-branchier codegen loses more in the synthesis
# inner loops than the icache saves. -Os on z80.c alone was FLAT (2026-07-09):
# text shrank 40% but us/Z80-step 3.37->3.42 and bucket-matched fps were
# identical, so Z80 stepping (~60% of snd) is at its interpreter floor; the
# next lever there is structural.
# Propagate EXTRA_DEFINES to the assembler too, so .S-file feature gates
# (e.g. -DMVS64_IDLEPROBE in m64k_asm.S) take effect like C ones.
ASFLAGS += $(EXTRA_DEFINES)
N64_ASFLAGS += $(EXTRA_DEFINES)
# ...and to the RSP assembler (rsp_*.S build with RSPASFLAGS, not ASFLAGS),
# so ucode-side verify gates (MVS64_BATCHDBG) can be driven the same way.
RSPASFLAGS += $(EXTRA_DEFINES)

ROMNAME=$(notdir $(basename $(ROM)))
ROMDIR=$(ROM:%.zip=%.n64)

all: mvsmakerom mvs64-${ROMNAME}.z64

test:
	make -f Makefile.tests all

$(BUILD_DIR)/mvs64-${ROMNAME}.dfs: $(ROM) mvsmakerom
	@echo "    [MVS] ${ROMDIR}"
	./mvsmakerom $(BIOS) $(ROM)
	@echo "    [DFS] $@"
	$(N64_MKDFS) $@ $(ROMDIR) >/dev/null

mvs64-${ROMNAME}.z64: $(BUILD_DIR)/mvs64-${ROMNAME}.dfs
mvs64-${ROMNAME}.z64: N64_ROM_TITLE="MVS64: ${ROMNAME}"
$(BUILD_DIR)/mvs64-${ROMNAME}.elf: $(obj)

mvsmakerom: $(obj_makerom)
	@echo "    [LD] $@"
	$(CC) $(LDFLAGS) -o $@ $^

clean:
	rm -f $(obj)
	rm -f $(obj_makerom)
	rm -f $(asm:%.S=$(BUILD_DIR)/%.o)
	rm -f $(rsp:%.S=$(BUILD_DIR)/%.rsp)
	rm -f $(src:%.c=$(BUILD_DIR)/%.d) $(asm:%.S=$(BUILD_DIR)/%.d)
	rm -f mvs64-*.elf
	rm -f mvs64-*.dfs
	rm -f mvs64-*.z64

-include $(src:%.c=$(BUILD_DIR)/%.d) $(asm:%.S=$(BUILD_DIR)/%.d) $(src_makerom:%.c=$(BUILD_DIR)/%.d)

.PHONY: clean test
